<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TrestleStartingTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F5ED</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_trestle_foreground</item>
        <item name="postSplashScreenTheme">@style/TrestleTheme</item>
    </style>
    <style name="TrestleTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:navigationBarColor">#F8F5ED</item>
        <item name="android:statusBarColor">#F8F5ED</item>
        <item name="android:windowBackground">#F8F5ED</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="TrestleGameTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">#171715</item>
        <item name="android:statusBarColor">#171715</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
