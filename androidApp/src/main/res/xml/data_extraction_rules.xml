<?xml version="1.0" encoding="utf-8"?>
<!--
    Trestle keeps nothing in cloud backups or device-to-device transfers. Saved sign-ins are encrypted with keys in
    the Android Keystore, which stay on the old device, so copied credentials could not be decrypted on the new one.
    Instance folders can be many gigabytes. allowBackup="false" alone does not stop device-to-device transfers for
    apps that target Android 12 or newer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
