<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x402000" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_trestle"
        android:label="Trestle"
        android:roundIcon="@mipmap/ic_trestle_round"
        android:supportsRtl="true"
        android:theme="@style/TrestleTheme"
        android:usesCleartextTraffic="false">
        <meta-data
            android:name="net.blockhost.trestle.CURSEFORGE_API_KEY"
            android:value="${curseForgeApiKey}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".game.MinecraftGameActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/TrestleGameTheme" />
    </application>
</manifest>
